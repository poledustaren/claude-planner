{
  "_": "Папка → проект Plane для claude-planner и agy-planner. Ключ — имя проекта в Plane, aliases — имена папок и репозиториев (* — любой хвост), paths — папки целиком. Рабочая копия — ~/.config/plane-projects.json; список проектов — Obsidian 32-project-docs.",
  "default": "исследования",
  "skip": ["*/scratch/*", "*/scratchpad/*", "*/.claude/projects/*"],
  "projects": {
    "agent hub v2": {"aliases": ["agent-hub", "agent-hub-*", "hub2"]},
    "hub analytics": {"aliases": ["hub-analytics*"]},
    "claude planner": {"aliases": ["claude-planner*", "cplan"]},
    "agy planner": {"aliases": ["agy-planner*"]},
    "devopsmcp": {"aliases": ["devopsmcp*"]},
    "devops": {"aliases": ["ops", "infra", "devops-ansible*", "plane", "net-map", "map-vault*", "dr", "vault-web", "vless*", "alerting", "alertmute", "secdetect", "netbird*", "monitoring"], "paths": ["~/infra", "~/dr"]},
    "fers": {"aliases": ["fers", "fers-*", "fers_*"]},
    "ascore": {"aliases": ["ascore", "ascore-*", "ascore_*", "uzhk*"]},
    "inspection": {"aliases": ["inspection*", "accsysteminspection*", "accountingsysteminspection*"]},
    "fuel": {"aliases": ["fuel", "fuel-*", "fuel_*", "fuelroute", "fuelprocessing", "fuel_processing*", "autogen-fuel"]},
    "avl chat": {"aliases": ["avl-chat*", "avl_chat*", "penpot*"]},
    "portal": {"aliases": ["portal", "portal-*", "analitics"]},
    "asip": {"aliases": ["asip", "asip-*", "its_always_sunny*"]},
    "wellsoft ui": {"aliases": ["wellsoft-ui*", "wellsoft-dashboards", "claude-ui-template"]},
    "wellsoft process map": {"aliases": ["wellsoft-process-map"]},
    "wellsoft onboarding": {"aliases": ["wellsoft-onboarding", "claude-onboarding"]},
    "opi6 lidar": {"aliases": ["opi6*"]},
    "3dscheme": {"aliases": ["3dscheme"]},
    "media studio": {"aliases": ["media-studio"]},
    "mtb chronicle": {"aliases": ["mtb-chronicle*"]},
    "svoidazzer": {"aliases": ["svoidazer", "svoidazzer"]},
    "train": {"aliases": ["train", "train-*"]},
    "webui": {"aliases": ["webui", "webui-*"]},
    "wika operator": {"aliases": ["wika", "wika-*"]},
    "task lab": {"aliases": ["task-lab*"]},
    "hermit lab": {"aliases": ["hermit-lab*"]},
    "claude review": {"aliases": ["claude-review*", "dsh-review"]},
    "cmpfm": {"aliases": ["cmpfm*"]},
    "flow mcp": {"aliases": ["flow-mcp*"]},
    "lkdemo": {"aliases": ["lkdemo*"]},
    "oauth": {"aliases": ["oauth", "oauth20clientserver"]},
    "obsidian": {"aliases": ["obsidian*"], "paths": ["~/vault"]},
    "profiles": {"aliases": ["profiles"]},
    "sip yandex": {"aliases": ["sip-yandex*"]},
    "vpn manager": {"aliases": ["vpn-manager*"]},
    "zhk entry": {"aliases": ["zhk-entry*"]}
  }
}
